# Extra variables the production HA overlay needs, IN ADDITION to the base .env.
# Append these to your root .env (the overlay reads the same ./.env file).

# ── Replica counts (per single host; raise once you add nodes) ───────────────
APP_REPLICAS=2          # 2+ = no app-tier SPOF + zero-downtime rolling restarts
QUEUE_REPLICAS=3        # scale to LLM rate limit (see docs/SCALING.md)
# DO NOT RAISE THIS ABOVE 1. Two limits, either of which alone is fatal:
#   1. The DuckDB data layer is single-writer (file locks). A second replica
#      cannot open the same project_<id>.duckdb read-write and will error.
#   2. CPU XTTS needs ~3GB more RAM per replica.
# Scaling voice horizontally requires splitting ingest out of the voice-engine
# first, or moving TTS to a cloud provider. See docs/SCALING.md.
VOICE_REPLICAS=1

# ── HAProxy stats dashboard (http://127.0.0.1:8404 via SSH tunnel) ───────────
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=change-me-haproxy-stats

# ── Grafana (http://127.0.0.1:3000 via SSH tunnel, or behind Caddy) ──────────
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ── Local LLM (Ollama) ───────────────────────────────────────────────────────
# Set to 1 to include deploy/production/ollama.override.yml in every deploy.sh
# invocation. REQUIRED when LLM_PROVIDER=ollama (deploy.sh refuses to start
# otherwise) and also used for the Groq-primary + Ollama-fallback setup.
# Set to 1 to run the local model as the safety net behind Groq. Worth doing:
# a free-tier daily quota running out is routine, and without a local tier the
# failure is silent empty replies on every channel at once.
#
# The fallback CHAIN itself needs no configuration — the voice-engine derives
# it from whichever provider keys are present, cloud tiers first and ollama
# last. This flag only decides whether the ollama container runs at all, which
# is a hosting decision (~3GB while generating) rather than a code default.
WITH_OLLAMA=0
# Pull the model once after the stack is up:
#   ./deploy/production/deploy.sh ollama-pull
#
# 7b on this host (48GB, ~10GB baseline): ~6GB while generating, and the best
# Urdu/multilingual coverage of the sizes that stay usable on CPU. It must
# stay <= the ollama container's memory cap in ollama.override.yml — a model
# larger than its own cgroup is OOM-killed the first time it is needed.
# 14b (~9GB) also fits if answer quality matters more than latency.
OLLAMA_MODEL=qwen2.5:7b
# Residency — match Ollama's role. 5m when it's a fallback behind a cloud
# provider (idle RAM is reclaimed); -1 when it is the PRIMARY provider, so
# nobody pays the ~16s cold load on the first message after a quiet spell.
OLLAMA_KEEP_ALIVE=5m

# ── MySQL monitoring user (used ONLY by mysqld-exporter) ─────────────────────
# Set a value, then create the DB user once:  ./deploy.sh exporter-user
MYSQL_EXPORTER_PASSWORD=change-me-exporter

# ── Alerting (optional) ──────────────────────────────────────────────────────
# Alertmanager does NOT read env vars — paste your webhook directly into
# deploy/production/monitoring/alertmanager.yml. This var is informational.
ALERT_SLACK_WEBHOOK=

# ── Disk hygiene (used by the prune cron — deploy.sh cron) ───────────────────
# Per-turn voice WAVs and local backups older than this are deleted.
# (default_speaker.wav is always kept.)
VOICE_OUTPUT_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=14
