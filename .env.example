# =============================================================================
# AI Voice CRM — deployment configuration (docker compose)
#
#   cp .env.example .env   then fill in the values below.
#
# Container networking (DB host, redis host, internal service URLs) is wired
# in docker-compose.yml — you only set secrets, domains and provider keys here.
# =============================================================================

# ── Domains & TLS (Caddy auto-provisions Let's Encrypt certs for these) ──────
# Two A/AAAA DNS records must point at this server's public IP.
APP_DOMAIN=crm.example.com
VOICE_DOMAIN=voice.example.com
ACME_EMAIL=admin@example.com

# ── Laravel app ──────────────────────────────────────────────────────────────
APP_NAME="AI Voice CRM"
APP_ENV=production
APP_DEBUG=false
# Generate once, then paste here (must stay stable across restarts):
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=

# ── Database (consumed by the mysql container AND the app) ───────────────────
# NOTE: deploy/mysql/init/01-grants.sql hard-codes the username `aicrm` to grant
# it rights over the per-project tenant DBs. If you change DB_USERNAME, update
# that file too (it only runs on a fresh mysql volume).
DB_DATABASE=ai-crm-config
DB_USERNAME=aicrm
DB_PASSWORD=change-me-app-db-password
DB_ROOT_PASSWORD=change-me-root-db-password
# Per-project tenant chat DBs are named <prefix><project_id> on the same MySQL.
# The app user is granted on ai-crm-client-% so it can provision them itself.
TENANT_DB_NAME_PREFIX=ai-crm-client-

# ── Redis (cache + sessions + queue) ─────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── Shared secrets: admin <-> voice-engine (MUST match on both sides) ────────
PYTHON_INTERNAL_SECRET=change-me-internal-secret
PYTHON_JWT_SECRET=change-me-jwt-secret

# ── LLM providers ────────────────────────────────────────────────────────────
# Supported: groq | gemini | cerebras | anthropic | ollama
LLM_PROVIDER=groq
# FALLBACK CHAIN — comma separated, tried left to right when a tier returns a
# retryable error (429 rate limit / quota, 5xx, timeout). Put the free cloud
# tiers first and the local model LAST, so exhausting one provider's daily quota
# moves to another fast provider rather than dropping to slow CPU inference.
#   groq  →  gemini  →  ollama
LLM_FALLBACK_PROVIDER=gemini,ollama
LLM_MAX_RETRIES=2

# Groq — free tier, fastest. https://console.groq.com
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=
# Google Gemini — free tier via AI Studio. https://aistudio.google.com/apikey
# Used through Gemini's OpenAI-compatible endpoint. Default: gemini-2.5-flash
GEMINI_API_KEY=
# Cerebras — optional third free tier. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Anthropic — paid, highest quality. Leave blank unless you want it.
ANTHROPIC_API_KEY=

# Ollama — the LAST tier of the chain above, and the only one with no quota to
# exhaust. It runs as a container in the stack, NOT on the host: setting
# WITH_OLLAMA=1 is what makes deploy.sh apply deploy/production/ollama.override.yml
# and actually start that container. Without it the chain ends at a provider that
# does not exist, and an exhausted Groq quota produces empty replies on every
# channel — which is precisely what "the fallback doesn't work" looks like.
#
# Pulling the weights on the HOST does nothing for the same reason: the
# voice-engine container resolves `ollama` on the compose network, so the model
# has to live in the ollama_models volume:
#   ./deploy/production/deploy.sh ollama-pull qwen2.5:7b
WITH_OLLAMA=1
# Service name on the compose network — NOT localhost. The code default is
# localhost:11434, which inside the voice-engine container is the container
# itself, where nothing is listening.
OLLAMA_BASE_URL=http://ollama:11434/v1
# MUST be a model that has actually been pulled into the volume (`ollama-pull`
# above, or `deploy.sh ollama-pull <model>`). A name that is not there answers
# 404 and burns the last tier of the chain.
OLLAMA_MODEL=qwen2.5:7b

# ── Voice models (CPU defaults) ──────────────────────────────────────────────
WHISPER_MODEL=base
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Optional ElevenLabs (opt-in per project; Coqui is the local/free default)
ELEVENLABS_API_KEY=

# ── Mail (optional — for password resets / notifications) ────────────────────
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com

# ── Cloudflare Turnstile (CAPTCHA on login / register / forgot-password) ─────
# Cloudflare dashboard -> Turnstile -> Add site. Add BOTH hostnames you serve
# (e.g. crm.serveai.com.pk and the duckdns one) or the widget refuses to render.
#
# Leave BOTH blank to disable: the widget isn't rendered and server-side
# verification is skipped, so nothing breaks. Setting only one is a
# misconfiguration — the site key alone gives you a decorative widget that
# blocks nothing.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Social sign-in (Google / Facebook buttons on the login page) ─────────────
# The buttons are always shown; until these are set, clicking one returns to
# the login page with "<Provider> sign-in isn't configured yet."
#
# Google  → https://console.cloud.google.com/apis/credentials
#           Create an OAuth 2.0 Client ID (type: Web application) and add this
#           EXACT authorised redirect URI:
#             https://<APP_DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
#
# Facebook → https://developers.facebook.com/apps  (Facebook Login product)
#            Valid OAuth Redirect URI:
#              https://<APP_DOMAIN>/auth/facebook/callback
#            NOTE: META_APP_ID/SECRET are shared with the WhatsApp/Instagram
#            channel integration — if those are already set, only the redirect
#            below is needed.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT=

# ── CRM OAuth integrations (optional — leave blank if unused) ────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_HOST=https://login.salesforce.com
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_AUTH_HOST=https://accounts.zoho.com
