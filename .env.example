# =============================================================================
# AI Voice CRM — deployment configuration (docker compose)
#
#   cp .env.example .env   then fill in the values below.
#
# Container networking (DB host, redis host, internal service URLs) is wired
# in docker-compose.yml — you only set secrets, domains and provider keys here.
# =============================================================================

# ── Domains & TLS (Caddy auto-provisions Let's Encrypt certs for these) ──────
# Two A/AAAA DNS records must point at this server's public IP.
APP_DOMAIN=crm.example.com
VOICE_DOMAIN=voice.example.com
ACME_EMAIL=admin@example.com

# ── Laravel app ──────────────────────────────────────────────────────────────
APP_NAME="AI Voice CRM"
APP_ENV=production
APP_DEBUG=false
# Generate once, then paste here (must stay stable across restarts):
#   docker compose run --rm app php artisan key:generate --show
APP_KEY=

# ── Database (consumed by the mysql container AND the app) ───────────────────
# NOTE: deploy/mysql/init/01-grants.sql hard-codes the username `aicrm` to grant
# it rights over the per-project tenant DBs. If you change DB_USERNAME, update
# that file too (it only runs on a fresh mysql volume).
DB_DATABASE=ai-crm-config
DB_USERNAME=aicrm
DB_PASSWORD=change-me-app-db-password
DB_ROOT_PASSWORD=change-me-root-db-password
# Per-project tenant chat DBs are named <prefix><project_id> on the same MySQL.
# The app user is granted on ai-crm-client-% so it can provision them itself.
TENANT_DB_NAME_PREFIX=ai-crm-client-

# ── Redis (cache + sessions + queue) ─────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── Shared secrets: admin <-> voice-engine (MUST match on both sides) ────────
PYTHON_INTERNAL_SECRET=change-me-internal-secret
PYTHON_JWT_SECRET=change-me-jwt-secret

# ── LLM providers ────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=
LLM_MAX_RETRIES=2
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Voice models (CPU defaults) ──────────────────────────────────────────────
WHISPER_MODEL=base
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Optional ElevenLabs (opt-in per project; Coqui is the local/free default)
ELEVENLABS_API_KEY=

# ── Mail (optional — for password resets / notifications) ────────────────────
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com

# ── CRM OAuth integrations (optional — leave blank if unused) ────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_HOST=https://login.salesforce.com
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_AUTH_HOST=https://accounts.zoho.com
