# Drives the From name and the body of verification/invite emails
# ("verify your email address on {APP_NAME}"), so it must be the brand.
APP_NAME="Serve AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Master / config DB — holds users, projects, clients, payment_plans, jobs.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai-crm-config
DB_USERNAME=root
DB_PASSWORD=

# Tenant chat DBs — one per project, auto-named `ai-crm-client-{project_id}`.
# Lives on the host below (typically our own infra, NOT the customer's CRM).
# Connection is configured at runtime by App\Services\Tenant\TenantManager.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_DB_NAME_PREFIX=ai-crm-client-

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Outbound mail ────────────────────────────────────────────────────────
# Email verification, password resets and team invites all go through here.
# With no working mailer, signup dead-ends at the "verify your email" screen.
#
# PRODUCTION — Resend over plain SMTP (no composer package required):
#   1. Add the sending domain at https://resend.com/domains and publish the
#      DKIM/SPF/MX records it gives you. Wait for "Verified".
#   2. Create an API key (https://resend.com/api-keys) with Sending access.
#   3. Fill in the block below. The username is the literal word `resend`;
#      the password is the API key (starts with `re_`).
#   4. MAIL_FROM_ADDRESS **must** be on the verified domain, or Resend
#      rejects the message with a 403.
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS="no-reply@your-verified-domain.com"
#
#   Port 587 is STARTTLS (MAIL_ENCRYPTION=tls). If outbound 587 is blocked,
#   Resend also listens on 2587 (STARTTLS) and 465/2465 (implicit TLS —
#   use MAIL_ENCRYPTION=ssl for those).
#
#   Verify it works after deploying:
#     php artisan tinker --execute="Mail::raw('ping', fn(\$m) => \$m->to('you@example.com')->subject('Serve AI mail test'));"
#
# LOCAL — mailpit (docker-compose) catches everything without sending;
# swap MAIL_MAILER=log to dump mail into storage/logs instead.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Cloudflare Turnstile (bot check on login / register / password reset) ─
# Keys from https://dash.cloudflare.com → Turnstile → your widget.
# The widget's Hostname Management list must include every domain the forms
# are served from (e.g. serveai.com.pk, www.serveai.com.pk) — a hostname
# that isn't listed fails verification with `invalid-input-response`.
# Leave both blank to disable the check entirely (see App\Rules\Turnstile).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Gemini LLM
GEMINI_API_KEY=
GEMINI_CALL_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# voice-engine integration (must match voice-engine/.env)
PYTHON_BASE_URL=http://127.0.0.1:8000
PYTHON_WS_URL=ws://127.0.0.1:8000/ws/turn
PYTHON_INTERNAL_SECRET=
PYTHON_JWT_SECRET=
PYTHON_TOKEN_TTL=3600

# Voice provider (Coqui is local + free; ElevenLabs is opt-in)
VOICE_DEFAULT_PROVIDER=coqui
ELEVENLABS_API_KEY=

# HubSpot OAuth (Tier 2 CRM integration). Create an app at
# https://developers.hubspot.com/, copy client_id/secret, and whitelist
# HUBSPOT_REDIRECT_URI in the app's Auth settings.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://127.0.0.1:8001/oauth/hubspot/callback

# Salesforce OAuth. Create a Connected App in Setup -> App Manager, enable
# OAuth, copy Consumer Key/Secret. SALESFORCE_LOGIN_HOST is the auth host
# (https://login.salesforce.com for prod, https://test.salesforce.com for
# sandbox). instance_url comes back in the token response and is persisted
# per data_source for subsequent API calls.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://127.0.0.1:8001/oauth/salesforce/callback
SALESFORCE_LOGIN_HOST=https://login.salesforce.com

# Pipedrive OAuth. Register an app at https://marketplace.pipedrive.com/.
# api_domain comes back in the token response (company-specific host).
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://127.0.0.1:8001/oauth/pipedrive/callback

# Zoho CRM OAuth. Register a Server-based client at
# https://api-console.zoho.com/. ZOHO_AUTH_HOST is region-specific:
#   accounts.zoho.com (US), .eu (EU), .in (IN), .com.au (AU), .com.cn (CN),
#   .jp (JP). api_domain comes back in the token response and is persisted.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://127.0.0.1:8001/oauth/zoho/callback
ZOHO_AUTH_HOST=https://accounts.zoho.com
