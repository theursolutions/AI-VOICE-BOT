# Drives the From name and the body of verification/invite emails
# ("verify your email address on {APP_NAME}"), so it must be the brand.
APP_NAME="Serve AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Master / config DB — holds users, projects, clients, payment_plans, jobs.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai-crm-config
DB_USERNAME=root
DB_PASSWORD=

# Tenant chat DBs — one per project, auto-named `ai-crm-client-{project_id}`.
# Lives on the host below (typically our own infra, NOT the customer's CRM).
# Connection is configured at runtime by App\Services\Tenant\TenantManager.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=
TENANT_DB_NAME_PREFIX=ai-crm-client-

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Outbound mail ────────────────────────────────────────────────────────
# Email verification, password resets and team invites all go through here.
# With no working mailer, signup dead-ends at the "verify your email" screen.
#
# PRODUCTION — Resend over plain SMTP (no composer package required):
#   1. Add the sending domain at https://resend.com/domains and publish the
#      DKIM/SPF/MX records it gives you. Wait for "Verified".
#   2. Create an API key (https://resend.com/api-keys) with Sending access.
#   3. Fill in the block below. The username is the literal word `resend`;
#      the password is the API key (starts with `re_`).
#   4. MAIL_FROM_ADDRESS **must** be on the verified domain, or Resend
#      rejects the message with a 403.
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS="no-reply@your-verified-domain.com"
#
#   Port 587 is STARTTLS (MAIL_ENCRYPTION=tls). If outbound 587 is blocked,
#   Resend also listens on 2587 (STARTTLS) and 465/2465 (implicit TLS —
#   use MAIL_ENCRYPTION=ssl for those).
#
#   Verify it works after deploying:
#     php artisan tinker --execute="Mail::raw('ping', fn(\$m) => \$m->to('you@example.com')->subject('Serve AI mail test'));"
#
# LOCAL — mailpit (docker-compose) catches everything without sending;
# swap MAIL_MAILER=log to dump mail into storage/logs instead.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Cloudflare Turnstile (bot check on login / register / password reset) ─
# Keys from https://dash.cloudflare.com → Turnstile → your widget.
# The widget's Hostname Management list must include every domain the forms
# are served from (e.g. serveai.com.pk, www.serveai.com.pk) — a hostname
# that isn't listed fails verification with `invalid-input-response`.
# Leave both blank to disable the check entirely (see App\Rules\Turnstile).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Gemini LLM
GEMINI_API_KEY=
GEMINI_CALL_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# voice-engine integration (must match voice-engine/.env)
PYTHON_BASE_URL=http://127.0.0.1:8000
PYTHON_WS_URL=ws://127.0.0.1:8000/ws/turn
PYTHON_INTERNAL_SECRET=
PYTHON_JWT_SECRET=
PYTHON_TOKEN_TTL=3600

# Voice provider (Coqui is local + free; ElevenLabs is opt-in)
VOICE_DEFAULT_PROVIDER=coqui
ELEVENLABS_API_KEY=

# HubSpot OAuth (Tier 2 CRM integration). Create an app at
# https://developers.hubspot.com/, copy client_id/secret, and whitelist
# HUBSPOT_REDIRECT_URI in the app's Auth settings.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://127.0.0.1:8001/oauth/hubspot/callback

# Salesforce OAuth. Create a Connected App in Setup -> App Manager, enable
# OAuth, copy Consumer Key/Secret. SALESFORCE_LOGIN_HOST is the auth host
# (https://login.salesforce.com for prod, https://test.salesforce.com for
# sandbox). instance_url comes back in the token response and is persisted
# per data_source for subsequent API calls.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://127.0.0.1:8001/oauth/salesforce/callback
SALESFORCE_LOGIN_HOST=https://login.salesforce.com

# Pipedrive OAuth. Register an app at https://marketplace.pipedrive.com/.
# api_domain comes back in the token response (company-specific host).
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
PIPEDRIVE_REDIRECT_URI=http://127.0.0.1:8001/oauth/pipedrive/callback

# Zoho CRM OAuth. Register a Server-based client at
# https://api-console.zoho.com/. ZOHO_AUTH_HOST is region-specific:
#   accounts.zoho.com (US), .eu (EU), .in (IN), .com.au (AU), .com.cn (CN),
#   .jp (JP). api_domain comes back in the token response and is persisted.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://127.0.0.1:8001/oauth/zoho/callback
ZOHO_AUTH_HOST=https://accounts.zoho.com

# ── Social sign-in: the "Continue with Google / Facebook" buttons ────────
# This is ACCOUNT LOGIN for our own dashboard. It is a completely separate
# concern from the Meta channels block below, which connects a CUSTOMER'S
# WhatsApp/Instagram/Facebook to our product.
#
# Use a SEPARATE Meta app from META_APP_ID for this — a Consumer-type app
# needing only `email` + `public_profile`, which require no App Review. Give
# login the NEWER app and leave onboarding on whichever app already passed
# Business Verification and App Review: none of that transfers between apps.
#
# Set these two keys EXPLICITLY. They fall back to META_APP_ID /
# META_APP_SECRET when blank (see config/services.php), which is convenient
# for a single-app install and a trap otherwise: swapping the channel-
# onboarding app then silently repoints the login button at an app that has
# neither this redirect URI whitelisted nor permission to release `email`.
#
# Redirect URIs to register (must match byte-for-byte):
#   Google   → Cloud Console → Credentials → your OAuth client
#              → Authorised redirect URIs: https://<APP_DOMAIN>/auth/google/callback
#   Facebook → Meta app → Facebook Login → Settings
#              → Valid OAuth Redirect URIs: https://<APP_DOMAIN>/auth/facebook/callback
#
# Verify with:  php artisan auth:doctor
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Meta channels: WhatsApp / Instagram / Facebook onboarding ───────────
# NOTE: a DIFFERENT Meta app from FACEBOOK_CLIENT_ID above. See that block.
# One Meta app drives all three. Create it at https://developers.facebook.com
# → My Apps → Create App → "Business".
#
# The permissions this needs (pages_messaging, instagram_manage_messages,
# whatsapp_business_messaging, business_management) are ALL App Review
# permissions: with an app in Development mode they work only for people
# listed as admins/testers on the app itself. Customers can onboard only
# after Business Verification + App Review pass. See docs/META_ONBOARDING.md.
META_APP_ID=
META_APP_SECRET=
# Fixed OAuth redirect registered in the Meta app under
# Facebook Login → Settings → Valid OAuth Redirect URIs:
#   https://<APP_DOMAIN>/meta/oauth/callback
# Leave blank to derive it from APP_URL. Set it whenever APP_URL does not
# match what is registered (http vs https, bare domain vs www) — the URI must
# match byte-for-byte or Meta answers "redirect URI is not whitelisted".
META_OAUTH_REDIRECT=
META_GRAPH_VERSION=v21.0
# Scopes are overridable per provider — see META_SCOPES_* at the end of this
# file. That is where an "Invalid Scope: <name>" error gets fixed.

# WhatsApp Embedded Signup — Meta's own ~2-minute popup, and the reason
# "Connect WhatsApp" doesn't leave the dashboard. Create the configuration
# under App → WhatsApp → Embedded Signup and paste its id here.
# LEAVE BLANK and the UI silently falls back to the redirect flow, which
# needs no configuration id — so an unconfigured install still works.
META_WA_CONFIG_ID=

# ── Instagram API with Instagram Login ───────────────────────────────────
# A SEPARATE product with SEPARATE credentials — these are NOT META_APP_ID
# and META_APP_SECRET. Find them under:
#   App dashboard → Instagram → API setup with Instagram login
#     → "Instagram app ID" and "Instagram app secret"
#
# Why bother when Instagram already works through Facebook Login: that path
# requires the IG account to be linked to a Facebook Page. Most business
# accounts are not, and for them the Facebook route simply finds nothing.
#
# LEAVE BLANK and "Connect Instagram" keeps using Facebook Login, so an
# existing install is unaffected by upgrading.
#
# Register all three of these under Instagram → API setup with Instagram
# login → Business login settings. Meta pings the deletion URL when you save
# it, so deploy before pasting.
#   OAuth redirect URI:  https://<APP_DOMAIN>/meta/instagram/callback
#   Deauthorize URL:     https://<APP_DOMAIN>/meta/instagram/deauthorize
#   Data deletion URL:   https://<APP_DOMAIN>/meta/data-deletion
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Leave blank to derive from APP_URL. Set it when APP_URL does not match what
# is registered (http vs https, bare vs www) — the URI must match byte-for-byte.
INSTAGRAM_OAUTH_REDIRECT=
# Override only if Meta renames a permission. Drop
# instagram_business_manage_comments if the app is not approved for it —
# one unapproved scope fails the whole consent screen.
INSTAGRAM_SCOPES=

# Inbound webhooks (App → WhatsApp → Configuration → Webhook)
#   Callback URL:  https://<APP_DOMAIN>/api/whatsapp/webhook
#   Verify token:  the value below (any random string; must match exactly)
META_WHATSAPP_VERIFY_TOKEN=
# Signature check on inbound webhooks. Defaults to META_APP_SECRET.
META_WHATSAPP_APP_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# BILLING — Stripe, geolocation, exchange rates
# ─────────────────────────────────────────────────────────────────────────
# Only SECRETS live here. Prices, plans, limits, features and trial lengths
# are database-driven and edited at /admin/billing/plans with no deploy.
# See SUPER_ADMIN_BILLING_GUIDE.md.

# Stripe (Dashboard → Developers → API keys). USD is the only billing
# currency — Products/Prices must be created in USD.
STRIPE_KEY=
STRIPE_SECRET=
# Dashboard → Developers → Webhooks → your endpoint → "Signing secret".
# Without this every webhook is rejected, so subscriptions never activate.
#   Endpoint URL: https://<APP_DOMAIN>/stripe/webhook
#   Events: checkout.session.completed, customer.subscription.created,
#           customer.subscription.updated, customer.subscription.deleted,
#           customer.subscription.trial_will_end, invoice.paid,
#           invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Pinned so a Stripe-side upgrade can't silently change payload shapes.
# Leave blank to follow the installed stripe-php (recommended). Pin only if you
# have deliberately upgraded your Stripe account to a different version.
STRIPE_API_VERSION=
STRIPE_AUTOMATIC_TAX=false

# Free-window lifecycle (approved model: Free = 7 days, no card, web chat
# only). Overridable per plan from the admin UI.
BILLING_FREE_WINDOW_DAYS=7
# read_only | widget_only | lockout
BILLING_FREE_ON_EXPIRY=read_only
BILLING_FREE_PURGE_DAYS=30
BILLING_PAST_DUE_GRACE_DAYS=7
# create_prorations | always_invoice | none
BILLING_PRORATION=create_prorations

# Master switch for buying. false = plan cards show prices/features but the
# "Choose plan" buttons become a muted "Coming soon" chip AND the checkout
# endpoints refuse. Free signup and the Enterprise contact link still work.
# Flip to true LOCALLY to test the full Stripe flow.
BILLING_CHECKOUT_ENABLED=false

# IP → country, for DISPLAY pricing only. Never gates access; a total
# failure here just means everyone sees USD, which is always correct.
# There is no Cloudflare in front of this app (Caddy is the TLS edge), so
# CF-IPCountry is unavailable — we do our own lookup.
#   maxmind — local GeoLite2 .mmdb, no network call. Recommended.
#   http    — ipapi.co lookup, for dev boxes with no .mmdb.
#   null    — always USD.
GEOIP_DRIVER=maxmind
# Free MaxMind account → Manage License Keys. Then: php artisan geoip:update
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_DATABASE_PATH=
GEOIP_HTTP_ENDPOINT=https://ipapi.co/{ip}/json/
GEOIP_CACHE_TTL=86400
# Blank = unknown country shows USD only. Set e.g. PK to assume a home market.
GEOIP_FALLBACK_COUNTRY=

# USD → local currency, for DISPLAY only. Never used as a charge amount.
# The pricing page never calls out: `php artisan billing:refresh-rates`
# (scheduled every 6h) writes to the exchange_rates table and the cache.
#   erapi             — open.er-api.com, free, no key. Default.
#   exchangerate_host — needs FX_API_KEY
#   openexchangerates — needs FX_API_KEY
FX_DRIVER=erapi
FX_API_KEY=
FX_CACHE_TTL=21600
FX_MAX_AGE_HOURS=72
# Master switch for the whole local-currency line.
FX_ENABLED=true

# Override the OAuth scopes per provider without a deploy. Meta renames and
# re-scopes permissions regularly, and a permission is only valid for an app
# that has the matching PRODUCT added in the dashboard — so "Invalid Scopes"
# is usually fixed here or there, not in code. Defaults live in
# packages/meta-channels/config/meta.php.
META_SCOPES_FACEBOOK=
META_SCOPES_INSTAGRAM=
META_SCOPES_WHATSAPP=
