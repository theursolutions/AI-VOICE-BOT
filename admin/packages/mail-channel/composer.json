{
    "name": "msd/mail-channel",
    "description": "Professional email channel — multi-mailbox SMTP/IMAP send & receive, threaded like WhatsApp/Instagram/Facebook. Provider-agnostic of the host app via a small handler contract, so it can be reused or sold standalone.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["email", "smtp", "imap", "mailbox", "laravel"],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/mail": "^10.0|^11.0",
        "illuminate/bus": "^10.0|^11.0",
        "webklex/php-imap": "^5.0|^6.0"
    },
    "autoload": {
        "psr-4": {
            "Msd\\MailChannel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Msd\\MailChannel\\MailChannelServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
