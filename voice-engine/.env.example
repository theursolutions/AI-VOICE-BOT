# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Shared secrets (must match admin/.env)
PYTHON_INTERNAL_SECRET=
PYTHON_JWT_SECRET=

# Admin webhook target
LARAVEL_BASE_URL=http://127.0.0.1:8001

# Models
WHISPER_MODEL=base
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Default speaker reference (path to a wav of ~10s clean audio)
DEFAULT_SPEAKER_WAV=./voice_outputs/default_speaker.wav

# --- RAG / vector store ---
# Local Qdrant: `docker run -p 6333:6333 qdrant/qdrant`
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crm_chunks
EMBEDDING_MODEL=models/text-embedding-004
RAG_CHUNK_MAX_TOKENS=500
RAG_CHUNK_OVERLAP=50
RAG_CRAWL_MAX_PAGES=50
RAG_CRAWL_MAX_DEPTH=2
