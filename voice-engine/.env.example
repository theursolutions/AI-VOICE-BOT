# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Shared secrets (must match admin/.env)
PYTHON_INTERNAL_SECRET=
PYTHON_JWT_SECRET=

# Admin webhook target
LARAVEL_BASE_URL=http://127.0.0.1:8001

# LLM provider + load resilience. On a 429/5xx/timeout the service retries
# with backoff, then fails over to the fallback provider (empty = none).
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_FALLBACK_PROVIDER=
LLM_MAX_RETRIES=2

# Models
WHISPER_MODEL=base
COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# --- Urdu support (optional) -----------------------------------------------
# STT: faster-whisper accepts a HuggingFace CTranslate2 repo id directly, so
# an Urdu fine-tune is a drop-in. Recommended for Urdu calls:
#   WHISPER_MODEL=kingabzpro/whisper-large-v3-urdu-ct2
# (CPU-only? large-v3 is slow for live calls — prefer a medium/turbo variant.)
#
# TTS: stock XTTS-v2 cannot speak Urdu. Point XTTS_CHECKPOINT_DIR at a local
# copy of the Urdu fine-tune (suhaibrashid17/XTTS-v2-Urdu-FT). The dir must
# contain config.json, model.pth and vocab.json. Voice cloning still works.
#   XTTS_CHECKPOINT_DIR=./models/xtts-v2-urdu-ft
# Leave empty to use COQUI_MODEL above (English + the other 16 XTTS langs).
XTTS_CHECKPOINT_DIR=

# Default speaker reference (path to a wav of ~10s clean audio)
DEFAULT_SPEAKER_WAV=./voice_outputs/default_speaker.wav

# --- Google voices (Gemini text-to-speech) — uses GEMINI_API_KEY ---
# Ready-made voices chosen per project/agent in the admin (Voices page).
# The free tier allows ~3 speech requests a minute. A billed (Tier 1) key
# still gets only 100 requests A DAY per TTS model, and a call makes one per
# sentence — raise the tier before real traffic.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Each model has its own quota: on a 429 the next is tried and the limited
# one rests until Google allows it again.
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
# Short phrases (greetings, "let me check", "anything else?", goodbyes) are
# saved here once spoken and never requested again. Empty = memory only.
GOOGLE_TTS_CACHE_DIR=./tts_cache

# --- Phone / SIP calls (Twilio, Asterisk) ---
# Caller talking over the AI cuts it off after this much continuous speech.
CALL_BARGE_IN=true
CALL_BARGE_IN_MS=600
# Earlier exchanges of the same call the model remembers.
CALL_HISTORY_TURNS=10
# Listening: gemini = words + language + mood + the caller's voice (for
# sir/madam) in one request, Whisper as fallback; whisper = fully local.
CALL_LISTENER=gemini
CALL_LISTEN_MODEL=gemini-3.1-flash-lite
CALL_LISTEN_TIMEOUT=6
# Silence that ends the caller's turn; a caller who stopped mid-sentence
# gets CALL_INCOMPLETE_WAIT_MS more before the AI answers.
CALL_END_SILENCE_MS=650
CALL_INCOMPLETE_WAIT_MS=1500
# Say a "let me check" line only when the lookup takes longer than this.
CALL_FILLER_AFTER_MS=300
# Google voices change their delivery with the caller's mood.
CALL_VOICE_EMOTION=true
# Quiet line: check in after IDLE_PROMPT s (after an answer) or IDLE_WAIT s
# (after the AI asked something); IDLE_GOODBYE s later, goodbye + hang up.
CALL_IDLE_PROMPTS=true
CALL_IDLE_PROMPT_SECONDS=4.5
CALL_IDLE_WAIT_SECONDS=8
CALL_IDLE_GOODBYE_SECONDS=6

# --- Asterisk (SIP trunks, PBXs, WebRTC) — off while the password is empty ---
# ARI = how we control calls; AudioSocket = how call audio reaches us.
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=ai-crm
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP=ai-crm
# Where our AudioSocket server listens, and the host:port ASTERISK connects
# to. With Asterisk in WSL that is the Windows host IP as WSL sees it
# (`ip route show default` inside WSL). Keep the port off the internet.
AUDIOSOCKET_BIND=0.0.0.0:9092
AUDIOSOCKET_ADVERTISE=127.0.0.1:9092

# --- RAG / vector store ---
# Local Qdrant: `docker run -p 6333:6333 qdrant/qdrant`
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crm_chunks
EMBEDDING_MODEL=models/text-embedding-004
RAG_CHUNK_MAX_TOKENS=500
RAG_CHUNK_OVERLAP=50
RAG_CRAWL_MAX_PAGES=50
RAG_CRAWL_MAX_DEPTH=2
